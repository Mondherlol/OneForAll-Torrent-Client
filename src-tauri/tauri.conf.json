{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneForAll",
  "version": "0.2.24",
  "identifier": "com.mondherlol.oneforall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneForAll — Torrent Client",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxRjgxNzlERjVDMjhCNjUKUldSbGk4TDFuUmY0Y2YyMjdIbHU2alFMQTZlak1xUExHdlBZczJubWlpYy9HM1VPUFBBaEtDcVIK",
      "endpoints": [
        "https://github.com/Mondherlol/OneForAll-Torrent-Client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
